pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = 'devspark'
        APP_IMAGE = 'devspark-app:prod'
        WEB_IMAGE = 'devspark-web:prod'
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo '📥 [CD] Récupération de la dernière version validée...'
                checkout scm
            }
        }

        stage('2. Build Base Docker Image') {
            steps {
                echo '🐳 [CD] Construction de l\'image Docker de base...'
                script {
                    if (isUnix()) {
                        sh "docker build -t ${APP_IMAGE} -f Dockerfile ."
                    } else {
                        bat "docker build -t %APP_IMAGE% -f Dockerfile ."
                    }
                }
            }
        }

        stage('3. Build Assets & Production Dependencies') {
            steps {
                echo '📦 [CD] Compilation des assets Vite et dépendances PHP de production...'
                script {
                    if (isUnix()) {
                        sh """
                            docker run --rm --volumes-from \${HOSTNAME} -w "\${WORKSPACE}" ${APP_IMAGE} sh -c "git config --global --add safe.directory '*' || true && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader && npm install && npm run build"
                        """
                    } else {
                        bat """
                            docker run --rm -v "%cd%:/var/www/html" -w /var/www/html %APP_IMAGE% sh -c "composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader && npm install && npm run build"
                        """
                    }
                }
            }
        }

        stage('4. Build Final Production Docker Images') {
            steps {
                echo '🐳 [CD] Construction des images de production avec les assets compilés (App & Nginx)...'
                script {
                    if (isUnix()) {
                        sh "docker build -t ${APP_IMAGE} -f Dockerfile ."
                        sh "docker build -t ${WEB_IMAGE} -f docker/nginx/Dockerfile ."
                    } else {
                        bat "docker build -t %APP_IMAGE% -f Dockerfile ."
                        bat "docker build -t %WEB_IMAGE% -f docker/nginx/Dockerfile ."
                    }
                }
            }
        }

        stage('5. Deploy Containers with Docker Compose') {
            steps {
                echo '🚀 [CD] Déploiement et démarrage des services (App, Nginx, MySQL, PhpMyAdmin)...'
                script {
                    if (isUnix()) {
                        sh "docker compose -f docker-compose.prod.yml down --remove-orphans || true"
                        sh "docker compose -f docker-compose.prod.yml up -d --remove-orphans"
                    } else {
                        bat "docker compose -f docker-compose.prod.yml down --remove-orphans || exit 0"
                        bat "docker compose -f docker-compose.prod.yml up -d --remove-orphans"
                    }
                }
            }
        }

        stage('6. Run Database Migrations & Optimize Cache') {
            steps {
                echo '⚡ [CD] Exécution des migrations MySQL et mise en cache Laravel...'
                script {
                    if (isUnix()) {
                        sh """
                            echo "Attente de l'état prêt pour MySQL..."
                            sleep 6
                            docker compose -f docker-compose.prod.yml exec -T app cp -n .env.example .env || true
                            docker compose -f docker-compose.prod.yml exec -T app php artisan key:generate --force || true
                            docker compose -f docker-compose.prod.yml exec -T app php artisan migrate --force
                            docker compose -f docker-compose.prod.yml exec -T app php artisan optimize:clear
                            docker compose -f docker-compose.prod.yml exec -T app php artisan config:cache
                            docker compose -f docker-compose.prod.yml exec -T app php artisan route:cache
                            docker compose -f docker-compose.prod.yml exec -T app php artisan view:cache
                        """
                    } else {
                        bat """
                            docker compose -f docker-compose.prod.yml exec -T app cp -n .env.example .env || exit 0
                            docker compose -f docker-compose.prod.yml exec -T app php artisan key:generate --force || exit 0
                            docker compose -f docker-compose.prod.yml exec -T app php artisan migrate --force
                            docker compose -f docker-compose.prod.yml exec -T app php artisan optimize:clear
                            docker compose -f docker-compose.prod.yml exec -T app php artisan config:cache
                            docker compose -f docker-compose.prod.yml exec -T app php artisan route:cache
                            docker compose -f docker-compose.prod.yml exec -T app php artisan view:cache
                        """
                    }
                }
            }
        }

        stage('7. Health Check & Smoke Tests') {
            steps {
                echo '🩺 [CD] Vérification du statut de l\'application déployée...'
                script {
                    if (isUnix()) {
                        sh """
                            docker compose -f docker-compose.prod.yml ps
                            docker run --rm --network devspark_network curlimages/curl:latest curl -s -f -o /dev/null http://web/ || curl -s -f -o /dev/null http://localhost:8000/ || true
                        """
                    } else {
                        bat "docker compose -f docker-compose.prod.yml ps"
                        bat "curl -s -f -o NUL http://localhost:8000/ || exit 0"
                    }
                }
            }
        }
    }

    post {
        success {
            echo '========================================================================'
            echo '🎉 DÉPLOIEMENT RÉUSSI AVEC SUCCÈS !'
            echo '🌐 Application accessible sur : http://localhost:8000'
            echo '📊 Interface PhpMyAdmin sur    : http://localhost:8081'
            echo '========================================================================'
        }
        failure {
            echo '❌ Échec du déploiement ! Vérifiez les logs avec : docker compose -f docker-compose.prod.yml logs'
        }
    }
}
